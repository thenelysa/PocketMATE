import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useGoogleLogin } from '@react-oauth/google';
import { useAuth } from '@/contexts/AuthContext';
import { Menu, X, Calendar, CreditCard, Lock, LayoutDashboard, CheckCircle, Shield, Smartphone, BarChart3, X as XIcon } from 'lucide-react';

const GOOGLE_CLIENT_ID = import.meta.env.VITE_GOOGLE_CLIENT_ID;

export function LandingPage() {
  const { user, signIn, isAuthenticated } = useAuth();
  const navigate = useNavigate();
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [isLoggingIn, setIsLoggingIn] = useState(false);
  const [showLoginModal, setShowLoginModal] = useState(false);

  const handleGoogleLogin = useGoogleLogin({
    onSuccess: (response) => {
      setIsLoggingIn(true);
      fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
        headers: { Authorization: `Bearer ${response.access_token}` },
      })
        .then((res) => res.json())
        .then((userInfo) => {
          signIn({
            id: userInfo.sub,
            email: userInfo.email,
            name: userInfo.name,
            picture: userInfo.picture,
          });
          setShowLoginModal(false);
          navigate('/app/dashboard');
        })
        .catch(() => {
          setIsLoggingIn(false);
        });
    },
    onError: () => {
      setIsLoggingIn(false);
    },
  });

  return (
    <div className="min-h-screen bg-[#F7F8F5] flex flex-col>
      {/* Header */}"
      <header className="sticky top-0 z-50 h-[72px] border-b border-[#D5ECEB] bg-[#F7F8F5]">
        <div className="max-w-[1110px] mx-auto px-4 h-full flex items-center justify-between>
          {/* Logo */}"
          <a href="/" className="flex items-center gap-2">
            <img src="/images/logo.png" alt="PocketMATE Logo" className="h-10 w-auto" />
            <span className="text-xl font-bold text-[#071936]>>PocketMATE</span">>
          </a">

          {/* Desktop Nav */}
          <nav className="hidden md:flex items-center gap-8>">
            <a href="#features" className="text-[#4B5D7A] hover:text-[#071936] text-sm">Features</a>
            <a href="#how-it-works" className="text-[#4B5D7A] hover:text-[#071936] text-sm">How It Works</a>
          </nav>

          {/* Auth Buttons */}
          <div className="hidden md:flex items-center gap-4>">>
            {isAuthenticated ? (
              <">
                <span className="text-[#071936] text-sm flex items-center gap-2>
                  {user?.picture ? ("
                    <img src={user.picture} alt={user.name} className="w-8 h-8 rounded-full" />
                  ) : (
                    <div className="w-8 h-8 rounded-full bg-[#078D88] flex items-center justify-center text-white text-sm>
                      {user?.name?.charAt(0).toUpperCase()}
                    </div>
                  )}
                  Hi, {user?.name?.split(' ')[0]}
                </span>
                <button
                  onClick={() => navigate('/app/dashboard')}"
                  className="bg-gradient-to-r from-[#078D88] to-[#19C4B6] text-white px-5 py-2.5 rounded-full text-sm hover:opacity-90 transition-opacity flex items-center gap-2"
                >
                  <LayoutDashboard className="w-4 h-4" />
                  Go to Dashboard
                </button>
              </>
            ) : null}
          </div>

          {/* Mobile Menu Button */}
          <button
            className="md:hidden text-[#071936]"
            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
          >
            {mobileMenuOpen ? <X className="w-6 h-6" /> : <Menu className="w-6 h-6" />}
          </button>
        </div>

        {/* Mobile Menu */}
        {mobileMenuOpen && (
          <div className="md:hidden absolute top-[72px] left-0 right-0 bg-[#F7F8F5] border-b border-[#D5ECEB] shadow-lg z-50>"
            <div className="flex flex-col p-4 gap-4>">
              <a href="#features" className="text-[#4B5D7A] hover:text-[#071936] text-sm py-2">Features</a>
              <a href="#how-it-works" className="text-[#4B5D7A] hover:text-[#071936] text-sm py-2">How It Works</a>
              <hr className="border-[#D5ECEB]" />
              {isAuthenticated ? (
                <button
                  onClick={() => { navigate('/app/dashboard'); setMobileMenuOpen(false); }}
                  className="bg-gradient-to-r from-[#078D88] to-[#19C4B6] text-white px-5 py-2.5 rounded-full text-sm flex items-center justify-center gap-2"
                >
                  <LayoutDashboard className="w-4 h-4" />
                  Go to Dashboard
                </button>
              ) : null}
            </div>
          </div>
        )}
      </header>

      {/* hero Section */}
      <section className="max-w-[1110px] mx-auto px-4 py-8">
        <div className="h-[470px] rounded-[26px] bg-[#F1FAFA] border border-[#D5ECEB] overflow-hidden>"
          <div className="h-full bg-[#F1FAFA] grid md:grid-cols-2>
            {/* Left Content */}"
            <div className="flex flex-col justify-center px-12 md:px-16>"
              <p className="text-[#078D88] text-xs font-bold tracking-wider mb-4>">>
                SMARTER BILL TRACKING
              </p">
              <h1 className="text-[52px] font-extrabold text-[#071936] leading-[1.05] mb-6"}}>
                Stay ahead of<br />every bill.
              </h1>
              <p className="text-[16px] text-[#4B5D7A] leading-relaxed mb-8 max-w-md>">>
                Track monthly bills, manage credit cards,<br />and see what's due—all in one calm,<br />secure place.
              </p">
              <div className="flex flex-col sm:flex-row gap-4>
                {isAuthenticated ? (
                  <button
                    onClick={() => navigate('/app/dashboard')}"
                    className="bg-gradient-to-r from-[#078D88] to-[#19C4B6] text-white px-8 py-3 rounded-full text-sm hover:opacity-90 transition-opacity whitespace-nowrap flex items-center justify-center gap-2"
}}
                  >
                    <LayoutDashboard className="w-5 h-5" />
                    Go to Dashboard
                  </button>
                ) : (
                  <button
                    onClick={() => setShowLoginModal(true)}
                    className="bg-gradient-to-r from-[#078D88] to-[#19C4B6] text-white px-8 py-3 rounded-full text-sm hover:opacity-90 transition-opacity whitespace-nowrap text-center"
}}
                  >
                    Login
                  </button>
                )}
              </div>
            </div>

            {/* Right Mascot */}
            <div className="hidden md:flex items-center justify-center>
              <img"
                src="/images/mascot.png"
                alt="PocketMATE Mascot"
                className="h-[400px] w-auto object-contain"
              />
            </div>
          </div>
        </div>
      </section>

      {/* Features Section */}
      <section id="features" className="max-w-[1110px] mx-auto px-4 py-16">
        <h2 className="text-3xl font-bold text-center text-[#071936] mb-12"}}>
          Features
        </h2>
        <div className="grid md:grid-cols-2 lg:grid-cols-4 gap-6>
          {/* Feature 1 */}"
          <div className="flex flex-col items-center text-center p-6 rounded-xl border border-[#D5ECEB] bg-[#F7F8F5] hover:shadow-lg transition-shadow>"
            <div className="w-14 h-14 rounded-full bg-[#DFF5F2] flex items-center justify-center mb-4>"
              <Calendar className="w-7 h-7 text-[#078D88]" />
            </div>
            <h3 className="text-lg font-semibold text-[#071936] mb-2>>Bill Tracking</h3">
            <p className="text-[#4B5D7A] text-sm leading-relaxed>>>
              Never miss a due date with smart reminders.
            </p>
          </div">

          {/* Feature 2 */}
          <div className="flex flex-col items-center text-center p-6 rounded-xl border border-[#D5ECEB] bg-[#F7F8F5] hover:shadow-lg transition-shadow>"
            <div className="w-14 h-14 rounded-full bg-[#DFF5F2] flex items-center justify-center mb-4>"
              <CreditCard className="w-7 h-7 text-[#078D88]" />
            </div>
            <h3 className="text-lg font-semibold text-[#071936] mb-2>>Credit Cards</h3">
            <p className="text-[#4B5D7A] text-sm leading-relaxed>>>
              Track all your cards in one place.
            </p>
          </div">

          {/* Feature 3 */}
          <div className="flex flex-col items-center text-center p-6 rounded-xl border border-[#D5ECEB] bg-[#F7F8F5] hover:shadow-lg transition-shadow>"
            <div className="w-14 h-14 rounded-full bg-[#DFF5F2] flex items-center justify-center mb-4>"
              <BarChart3 className="w-7 h-7 text-[#078D88]" />
            </div>
            <h3 className="text-lg font-semibold text-[#071936] mb-2>>Reports</h3">
            <p className="text-[#4B5D7A] text-sm leading-relaxed>>>
              Export reports and track spending.
            </p>
          </div">

          {/* Feature 4 */}
          <div className="flex flex-col items-center text-center p-6 rounded-xl border border-[#D5ECEB] bg-[#F7F8F5] hover:shadow-lg transition-shadow>"
            <div className="w-14 h-14 rounded-full bg-[#DFF5F2] flex items-center justify-center mb-4>"
              <Shield className="w-7 h-7 text-[#078D88]" />
            </div>
            <h3 className="text-lg font-semibold text-[#071936] mb-2>>Secure</h3">
            <p className="text-[#4B5D7A] text-sm leading-relaxed>>>
              Your data is encrypted and protected.
            </p>
          </div>
        </div>
      </section">

      {/* How It Works Section */}
      <section id="how-it-works" className="max-w-[1110px] mx-auto px-4 py-16 bg-gray-100 rounded-[26px] mb-8">
        <h2 className="text-3xl font-bold text-center text-[#071936] mb-12"}}>
          How It Works
        </h2>
        <div className="grid md:grid-cols-3 gap-8>
          {/* Step 1 */}"
          <div className="flex flex-col items-center text-center>"
            <div className="w-16 h-16 rounded-full bg-[#078D88] flex items-center justify-center text-white text-2xl font-bold mb-6"}}>
              1
            </div>
            <h3 className="text-xl font-semibold text-[#071936] mb-3>>Sign Up Free</h3">
            <p className="text-[#4B5D7A] text-sm leading-relaxed>>>
              Create your free account in seconds using Google Sign-in.
            </p>
          </div">

          {/* Step 2 */}
          <div className="flex flex-col items-center text-center>"
            <div className="w-16 h-16 rounded-full bg-[#078D88] flex items-center justify-center text-white text-2xl font-bold mb-6"}}>
              2
            </div>
            <h3 className="text-xl font-semibold text-[#071936] mb-3>>Add Your Bills</h3">
            <p className="text-[#4B5D7A] text-sm leading-relaxed>>>
              Import bills manually or from PDF invoices. Add credit cards too.
            </p>
          </div">

          {/* Step 3 */}
          <div className="flex flex-col items-center text-center>"
            <div className="w-16 h-16 rounded-full bg-[#078D88] flex items-center justify-center text-white text-2xl font-bold mb-6"}}>
              3
            </div>
            <h3 className="text-xl font-semibold text-[#071936] mb-3>>Stay on Track</h3">
            <p className="text-[#4B5D7A] text-sm leading-relaxed>>>
              Get reminders before due dates and track your spending.
            </p>
          </div>
        </div>
      </section">

      {/* Footer */}
      <footer className="border-t border-[#D5ECEB] py-8 mt-auto">
        <div className="max-w-[1110px] mx-auto px-4 text-center text-sm text-[#4B5D7A]>>
          <p>&copy; 2026 PocketMATE. All rights reserved.</p>"
          <p className="mt-1>PocketMATE</p>
        </div>
      </footer>

      {/* Login Modal */}
      {showLoginModal && ("
        <div className="fixed inset-0 z-50 flex items-center justify-center animate-fade-in>
          {/* Overlay */}
          <div"
            className="absolute inset-0 bg-gradient-to-br from-[#071936]/70 via-[#4B5D7A]/50 to-[#071936]/60 backdrop-blur-sm animate-fade-in>
            onClick={() => setShowLoginModal(false)}
          />

          {/* Modal Content */}"
          <div className="relative w-full max-w-md bg-[#F7F8F5] rounded-2xl shadow-xl p-8 mx-4 animate-slide-up>
            {/* Close Button */}
            <button
              onClick={() => setShowLoginModal(false)}"
              className="absolute top-4 right-4 text-[#4B5D7A] hover:text-[#071936]"
            >
              <XIcon className="w-6 h-6" />
            </button>

            {/* Welcome back card */}
            <div className="text-center>"
              <h2 className="text-2xl font-bold text-[#071936] mb-2"}}>Welcome back</h2>
              <p className="text-[#4B5D7A] mb-8>>>
                Sign in to continue to PocketMATE
              </p>

              {/* Google Login */}
              <button
                onClick={() => handleGoogleLogin()}
                disabled={isLoggingIn}
                className="w-full py-3 bg-[#F7F8F5] border-2 border-[#D6E1E8] text-[#071936] rounded-xl hover:bg-gray-100 transition-colors disabled:opacity-50 flex items-center justify-center gap-3"
}}
              >
                <svg className="w-5 h-5" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                </svg>
                Continue with Google
              </button>

            </div>
          </div>
        </div>
      )}
    </div>
  );
}
