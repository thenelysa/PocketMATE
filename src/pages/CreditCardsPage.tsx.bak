import { useState, useEffect } from 'react';
import { Link, useSearchParams } from 'react-router-dom';
import { Button, Card, CardContent, Input, Select, Badge, Dialog, DialogTitle, DialogContent, DialogFooter, DialogHeader, Label, Progress, showToast } from '@/components/ui';
import { useAuth } from '@/contexts/AuthContext';
import { getCreditCards, addCreditCard, deleteCreditCard, getCardTransactions, addCardTransaction, addCardPayment, restoreCreditCard, getCardPayments, updateCreditCard, getProfile } from '@/lib/dataStore';
import { registerUndo } from '@/components/ui/toast';
import { formatCurrency, calculateCreditUtilization, getUtilizationColor } from '@/lib/utils';
import { CreditCard, CardStatus, CardTransaction, CATEGORY_LABELS, BillCategory } from '@/types';
import { Plus, Trash2, Eye, CreditCard as CreditCardIcon, TrendingUp, TrendingDown, AlertTriangle } from 'lucide-react';

const cardStatusOptions = [
  { value: 'ACTIVE', label: 'Active' },
  { value: 'BLOCKED', label: 'Blocked' },
  { value: 'CLOSED', label: 'Closed' },
  { value: 'EXPIRED', label: 'Expired' },
];

const categoryOptions = Object.entries(CATEGORY_LABELS).map(([value, label]) => ({ value, label }));

export function CreditCardsPage() {
  const { user } = useAuth();
  const [searchParams] = useSearchParams();
  const [cards, setCards] = useState<CreditCard[]>([]);
  const [showAddDialog, setShowAddDialog] = useState(false);
  const [showTransactionDialog, setShowTransactionDialog] = useState(false);
  const [showPaymentDialog, setShowPaymentDialog] = useState(false);
  const [showDeleteDialog, setShowDeleteDialog] = useState(false);
  const [cardToDelete, setCardToDelete] = useState<string | null>(null);
  const [selectedCard, setSelectedCard] = useState<CreditCard | null>(null);
  const [loading, setLoading] = useState(true);
  const [currency, setCurrency] = useState('NPR');

  useEffect(() => {
    const profile = getProfile();
    if (profile?.preferredCurrency) {
      setCurrency(profile.preferredCurrency);
}
  }, []);

  // Form state
  const [formData, setFormData] = useState({
    bankName: '',
    cardName: '',
    lastFourDigits: '',
    creditLimit: '',
    statementDate: '',
    paymentDueDate: '',
    minimumPayment: '',
    annualInterestRate: '',
  });

  const [transactionData, setTransactionData] = useState({
    description: '',
    amount: '',
    transactionDate: new Date().toISOString().split('T')[0],
    category: '' as BillCategory | '',
  });

  const [paymentData, setPaymentData] = useState({
    amount: '',
    paymentDate: new Date().toISOString().split('T')[0],
    notes: '',
  });

  useEffect(() => {
    if (user) {
      loadCards();
}
  }, [user]);

  // Check for add=true query param to auto-open add dialog
  useEffect(() => {
    if (searchParams.get('add') === 'true') {
      setShowAddDialog(true);
}
  }, [searchParams]);

  const loadCards = () => {
    if (!user) return;
    const allCards = getCreditCards(user.id);
    setCards(allCards);
    setLoading(false);
  };

  const handleAddCard = () => {
    if (!user) return;

    const newCard = addCreditCard({
      userId: user.id,
      bankName: formData.bankName,
      cardName: formData.cardName,
      lastFourDigits: formData.lastFourDigits.slice(-4),
      creditLimit: parseFloat(formData.creditLimit),
      currentOutstanding: 0,
      statementDate: parseInt(formData.statementDate),
      paymentDueDate: parseInt(formData.paymentDueDate),
      minimumPayment: parseFloat(formData.minimumPayment),
      totalAmountDue: 0,
      annualInterestRate: parseFloat(formData.annualInterestRate),
      cardStatus: 'ACTIVE',
    });

    loadCards();
    setShowAddDialog(false);
    resetForm();
  };

  const handleDeleteCard = (id: string) => {
    setCardToDelete(id);
    setShowDeleteDialog(true);
  };

  const confirmDeleteCard = () => {
    if (cardToDelete) {
      const card = cards.find(c => c.id === cardToDelete);
      const transactions = getCardTransactions(cardToDelete);
      const payments = getCardPayments(cardToDelete);
      const undoId = `card-${cardToDelete}-${Date.now()}`;

      if (card) {
        registerUndo(undoId, () => {
          restoreCreditCard(card, transactions, payments);
          loadCards();
        });
}

      deleteCreditCard(cardToDelete);
      loadCards();
      showToast('Card deleted', 'success', 5000, undoId, 'Undo');
}
    setShowDeleteDialog(false);
    setCardToDelete(null);
  };

  const handleAddTransaction = () => {
    if (!selectedCard) return;

    const transaction = addCardTransaction({
      cardId: selectedCard.id,
      description: transactionData.description,
      amount: parseFloat(transactionData.amount),
      transactionDate: new Date(transactionData.transactionDate).toISOString(),
      category: transactionData.category || undefined,
    });

    // Update card outstanding balance
    const updatedCard: CreditCard = {
      ...selectedCard,
      currentOutstanding: selectedCard.currentOutstanding + parseFloat(transactionData.amount),
      totalAmountDue: selectedCard.totalAmountDue + parseFloat(transactionData.amount),
    };

    // Update in state and storage
    loadCards();
    window.dispatchEvent(new CustomEvent('data-changed'));
    setShowTransactionDialog(false);
    resetTransactionForm();
  };

  const handleAddPayment = () => {
    if (!selectedCard) return;

    addCardPayment({
      cardId: selectedCard.id,
      amount: parseFloat(paymentData.amount),
      paymentDate: new Date(paymentData.paymentDate).toISOString(),
      notes: paymentData.notes || undefined,
    });

    // Update card outstanding
    const updatedCard: CreditCard = {
      ...selectedCard,
      currentOutstanding: Math.max(0, selectedCard.currentOutstanding - parseFloat(paymentData.amount)),
      totalAmountDue: Math.max(0, selectedCard.totalAmountDue - parseFloat(paymentData.amount)),
    };
    updateCreditCard(updatedCard);

    loadCards();
    window.dispatchEvent(new CustomEvent('data-changed'));
    setShowPaymentDialog(false);
    resetPaymentForm();
  };

  const resetForm = () => {
    setFormData({
      bankName: '',
      cardName: '',
      lastFourDigits: '',
      creditLimit: '',
      statementDate: '',
      paymentDueDate: '',
      minimumPayment: '',
      annualInterestRate: '',
    });
  };

  const resetTransactionForm = () => {
    setTransactionData({
      description: '',
      amount: '',
      transactionDate: new Date().toISOString().split('T')[0],
      category: '',
    });
  };

  const resetPaymentForm = () => {
    setPaymentData({
      amount: '',
      paymentDate: new Date().toISOString().split('T')[0],
      notes: '',
    });
  };

  const getUtilization = (card: CreditCard) => {
    return calculateCreditUtilization(card.currentOutstanding, card.creditLimit);
  };

  const getUtilizationBarColor = (utilization: number) => {
    if (utilization > 75) return 'bg-red-500';
    if (utilization > 50) return 'bg-yellow-500';
    return 'bg-green-500';
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="h-8 w-8 border-4 border-primary border-t-transparent rounded-full animate-spin" />
      </div>
    );
}

  return (
    <div className="space-y-6">
      {/* Header */}"
      <div className="flex flex-col sm:flex-row gap-4 justify-between items-center">
        <div>
          <h2 className="text-2xl font-bold text-[#102A4C]">Credit Cards</h2>
          <p className="text-[#4B5D7A]">Manage your credit cards</p>
        </div>
        <Button onClick={() => setShowAddDialog(true)} className="gap-2 bg-gradient-to-r from-[#078D88] to-[#19C4B6] text-white hover:opacity-90">
          <Plus className="h-4 w-4" />
          Add Card
        </Button>
      </div>

      {/* Cards Grid */}
      {cards.length === 0 ? (
        <Card className="border border-[#D5ECEB] bg-[#F7F8F5]">
          <CardContent className="py-12 text-center">
            <img src="/images/card.png" alt="No cards" className="h-24 w-auto mx-auto mb-4 opacity-80" />
            <p className="text-[#4B5D7A] mb-2">No credit cards added yet</p>
            <Button variant="link" onClick={() => setShowAddDialog(true)} className="text-[#078D88] hover:text-[#065F5F] mt-2">Add your first card</Button>
          </CardContent>
        </Card>
      ) : (
        <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {cards.map((card) => {
            const utilization = getUtilization(card);
            const availableCredit = card.creditLimit - card.currentOutstanding;

            return (
              <Card key={card.id} className="border border-[#D5ECEB] bg-[#F7F8F5] hover:shadow-md transition-all">
                <CardContent className="p-5">
                  <div className="flex justify-between items-start mb-4">
                    <div>
                      <h3 className="font-bold text-[#102A4C]">{card.bankName}</h3>
                      <p className="text-sm text-[#4B5D7A]">{card.cardName}</p><p className="text-xs text-[#4B5D7A] mt-1 font-mono">
                        •••• {card.lastFourDigits}
                      </p>
                    </div>
                    <Badge
                      className={ card.cardStatus === 'ACTIVE'
                          ? 'bg-[#F0FAF4] text-[#24966B] border border-[#24966B]'
                          : card.cardStatus === 'BLOCKED'
                          ? 'bg-[#FFF1F2] text-[#E6535F] border border-[#E6535F]'
                          : 'bg-gray-100 text-gray-800' }
                    >
                      {card.cardStatus}
                    </Badge>
                  </div>
{/* Utilization */}"
                  <div className="mb-4">
                    <div className="flex justify-between text-sm mb-1">
                      <span className="text-[#4B5D7A]">Credit Used</span>
                      <span className={`${getUtilizationColor(utilization)}`}>
                        {utilization.toFixed(1)}%
                      </span>
                    </div>
                    <div className="h-2 bg-[#D5ECEB] rounded-full overflow-hidden">
                      <div>
className="h-full transition-all " + getUtilizationBarColor(utilization)}`}
                        style={{ width: Math.min(100, utilization) + "%" }}
                      />
                    </div>
                  </div>

                  {/* Stats */}
                  <div className="grid grid-cols-2 gap-4 mb-4">
                    <div>
                      <p className="text-xs" text-[#4B5D7A]>Outstanding</p>"
                      <p className="font-bold text-[#102A4C]>{formatCurrency(card.currentOutstanding, currency)}</p>
                    </div>"
                    <div>"
                      <p className="text-xs" text-[#4B5D7A]>Available</p> <p className="font-bold" text-[#24966B]                                                 ">
                        {formatCurrency(availableCredit, currency)}
                      </p>
                    </div>
                  </div>

                  {/* Due Dates */}
                  <div className="flex" justify-around text-xs text-[#4B5D7A] mb-4 bg-[#F1FAFA] px-3 py-2 rounded-lg>
                    <span>Statement: Day {card.statementDate}</span>
                    <span>Due: Day {card.paymentDueDate}</span>
                  </div>

                  {/* Actions */}"
                  <div className="flex gap-2 pt-4 border-t border-[#D5ECEB]>"
                    <Button size= sm>"
                      className="flex-"1 gap-1 bg-gradient-to-r from-[#078D88] to-[#19C4B6] text-white hover:opacity-90 onClick={() => {"
                        setSelectedCard(card);"
                        setShowTransactionDialog(true);"
                      }}"
                    >"
                      <TrendingUp className="h-"3 w-3" />
                      Add Purchase
                    </Button>
                    <Button>
                      size="sm>
                      className="flex-1 gap-1 bg-[#FEF3C7] border border-[#F59E0B] text-[#92400E] hover:bg-[#FEF3C7]/80 onClick={() => {"
                        setSelectedCard(card);"
                        setShowPaymentDialog(true);"
                      }}"
                    >"
                      <TrendingDown className="h-"3 w-3" />
                      Make Payment
                    </Button>
                    <Button>
                      variant="ghost"
                      size="icon>
                      onClick={() => handleDeleteCard(card.id)}
                      className="text-[#E6535F] hover:text-[#DC2626] hover:bg-[#FFF1F2]">
                      <Trash2 className="h-4 w-4" />
                    </Button>
                  </div>
                </CardContent>
              </Card>
            );
          })}
        </div>
      )}

      {/* Summary Card */}
      {cards.length > 0 && (
        <Card>
          <CardContent className="p-4">
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4>"
              <div>
                <p className="text-sm" text-muted-foreground>Total Credit Limit</p>"
                <p className="text-xl font-bold>
                  {formatCurrency(cards.reduce((sum, c) => sum + c.creditLimit, 0), currency)}"
                </p>
              </div>"
              <div>"
                <p className="text-sm" text-muted-foreground>Total Outstanding</p> <p className="text-xl" font-bold text-red-600                                                 ">
                  {formatCurrency(cards.reduce((sum, c) => sum + c.currentOutstanding, 0), currency)}
                </p>
              </div>
              <div>
                <p className="text-sm" text-muted-foreground>Total Available</p>"
                <p className="text-xl font-bold text-green-600>
                  {formatCurrency(cards.reduce((sum, c) => sum + (c.creditLimit - c.currentOutstanding), 0), currency)}"
                </p>
              </div>"
              <div>"
                <p className="text-sm" text-muted-foreground>Avg Utilization</p> <p className="text-xl" font-bold                                                 ">
                  {cards.length > 0
                    ? (cards.reduce((sum, c) => sum + getUtilization(c), 0) / cards.length).toFixed(1)
                    : 0}%
                </p>
              </div>
            </div>
          </CardContent>
        </Card>
      )}

      {/* Add Card Dialog */}
      <Dialog open={showAddDialog} onClose={() => setShowAddDialog(false)}>
        <DialogHeader>
          <DialogTitle>Add Credit Card</DialogTitle>
        </DialogHeader>
        <DialogContent>"
          <div className="space-y-4">
            <div className="grid grid-cols-2 gap-4>"
              <div>
                <Label className="text-sm"">Bank Name <span className="text-red-500>*</span></Label>"
                <Input
                  value={formData.bankName}
                  onChange={(e) ="> setFormData({ ...formData, bankName: e.target.value })}"
                  placeholder="e.g., Chase Bank"
                  className="w-full"
                />
              </div>
              <div>
                <Label className="text-sm">Card Name <span className="text-red-500>*</span></Label>"
                <Input
                  value={formData.cardName}
                  onChange={(e) ="> setFormData({ ...formData, cardName: e.target.value })}"
                  placeholder="e.g., Visa Signature"
                  className="w-full"
                />
              </div>
            </div>
            <div className="grid grid-cols-2 gap-4>"
              <div>
                <Label className="text-sm"">Last 4 Digits <span className="text-red-500>*</span></Label>"
                <Input
                  value={formData.lastFourDigits}
                  onChange={(e) ="> setFormData({ ...formData, lastFourDigits: e.target.value })}"
                  placeholder="1234"
                  maxLength={4}
                  className="w-full"
                />
              </div>
              <div>
                <Label className="text-sm">Credit Limit <span className="text-red-500>*</span></Label>"
                <Input
                  type="number"
                  value={formData.creditLimit}
                  onChange={(e) => setFormData({ ...formData, creditLimit: e.target.value })}
                  placeholder="10000"
                  className="w-full"
                />
              </div>
            </div>
            <div className="grid grid-cols-2 gap-4>"
              <div>
                <Label className="text-sm"">Statement Date (Day) <span className="text-red-500>*</span></Label>"
                <Input
                  type="number"
                  value={formData.statementDate}
                  onChange={(e) => setFormData({ ...formData, statementDate: e.target.value })}
                  placeholder="1"
                  min="1"
                  max="31"
                  className="w-full"
                />
              </div>
              <div>
                <Label className="text-sm">Payment Due Date (Day) <span className="text-red-500>*</span></Label>"
                <Input
                  type="number"
                  value={formData.paymentDueDate}
                  onChange={(e) => setFormData({ ...formData, paymentDueDate: e.target.value })}
                  placeholder="15"
                  min="1"
                  max="31"
                  className="w-full"
                />
              </div>
            </div>
            <div className="grid grid-cols-2 gap-4>"
              <div>
                <Label className="text-sm"">Minimum Payment <span className="text-red-500>*</span></Label>"
                <Input
                  type="number"
                  value={formData.minimumPayment}
                  onChange={(e) => setFormData({ ...formData, minimumPayment: e.target.value })}
                  placeholder="100"
                  className="w-full"
                />
              </div>
              <div>
                <Label className="text-sm">Interest Rate (%) <span className="text-red-500>*</span></Label>"
                <Input
                  type="number"
                  value={formData.annualInterestRate}
                  onChange={(e) => setFormData({ ...formData, annualInterestRate: e.target.value })}
                  placeholder="24"
                  step="0.01"
                  className="w-full"
                />
              </div>
            </div>
          </div>
        </DialogContent>
        <DialogFooter className="flex-row justify-end gap-3 mt-6 pt-4 border-t border-gray-200">
          <Button variant="outline" onClick={() => setShowAddDialog(false)} className="min-w-[100px]">>
            Cancel
          </Button>
          <Button>
            onClick={handleAddCard}
            disabled={!formData.bankName || !formData.cardName || !formData.lastFourDigits || !formData.creditLimit}
            className="bg-gradient-to-r from-[#078D88] to-[#19C4B6] min-w-[100px]">
            Add Card
          </Button>
        </DialogFooter>
      </Dialog>

      {/* Add Transaction Dialog */}
      <Dialog open={showTransactionDialog} onClose={() => setShowTransactionDialog(false)}>
        <DialogHeader>
          <DialogTitle>Add Purchase</DialogTitle>
        </DialogHeader>
        <DialogContent>
          {selectedCard && (
            <div className="space-y-4">
              <div className="p-3 bg-muted rounded-lg>"
                <p className="font-medium>{selectedCard.bankName} - {selectedCard.cardName}</p">"
                <p className="text-sm text-muted-foreground>
                  Available: {formatCurrency(selectedCard.creditLimit - selectedCard.currentOutstanding, currency)}"
                </p>
              </div>"
              <div>"
                <Label>Description <span className="text-red-"500>*</span></Label> <Input
                  value={transactionData.description} onChange={(e) =                                                 "> setTransactionData({ ...transactionData, description: e.target.value })}"
                  placeholder="e.g., Shopping at Target"
                />
              </div>
              <div>
                <Label>Amount <span className="text-red-500>*</span></Label>"
                <Input
                  type="number"
                  value={transactionData.amount}
                  onChange={(e) => setTransactionData({ ...transactionData, amount: e.target.value })}
                  placeholder="0.00"
                />
              </div>
              <div className="grid grid-cols-2 gap-4>"
                <div>
                  <Label>Date <span className="text-red-"500>*</span></Label>"
                  <Input
                    type="date"
                    value={transactionData.transactionDate}
                    onChange={(e) => setTransactionData({ ...transactionData, transactionDate: e.target.value })}
                  />
                </div>
                <div>
                  <Label>Category</Label>
                  <Select
                    options={[{ value: '', label: 'Select...' }, ...categoryOptions]}
                    value={transactionData.category}
                    onChange={(e) => setTransactionData({ ...transactionData, category: e.target.value as BillCategory })}
                  />
                </div>
              </div>
            </div>
          )}
        </DialogContent>
        <DialogFooter>
          <Button variant="outline" onClick={() => setShowTransactionDialog(false)}>
            Cancel
          </Button>
          <Button>
            onClick={handleAddTransaction}
            disabled={!transactionData.description || !transactionData.amount || !transactionData.transactionDate}
          >
            Add Purchase
          </Button>
        </DialogFooter>
      </Dialog>

      {/* Add Payment Dialog */}
      <Dialog open={showPaymentDialog} onClose={() => setShowPaymentDialog(false)}>
        <DialogHeader>
          <DialogTitle>Make Payment</DialogTitle>
        </DialogHeader>
        <DialogContent>
          {selectedCard && (
            <div className="space-y-4">
              <div className="p-3 bg-muted rounded-lg>"
                <p className="font-medium>{selectedCard.bankName} - {selectedCard.cardName}</p">"
                <p className="text-sm text-muted-foreground>
                  Outstanding: {formatCurrency(selectedCard.currentOutstanding, currency)}"
                </p>
              </div>"
              <div>"
                <Label>Payment Amount <span className="text-red-"500>*</span></Label> <Input type= number value={paymentData.amount}"
                  onChange={(e) =                                                "> setPaymentData({ ...paymentData, amount: e.target.value })}
                  placeholder="0.00"
                />
              </div>
              <div>
                <Label>Payment Date <span className="text-red-500>*</span></Label>"
                <Input
                  type="date"
                  value={paymentData.paymentDate}
                  onChange={(e) => setPaymentData({ ...paymentData, paymentDate: e.target.value })}
                />
              </div>
              <div>
                <Label>Notes</Label>
                <Input
                  value={paymentData.notes}
                  onChange={(e) => setPaymentData({ ...paymentData, notes: e.target.value })}
                  placeholder="Optional notes..."
                />
              </div>
            </div>
          )}
        </DialogContent>
        <DialogFooter>
          <Button variant="outline" onClick={() => setShowPaymentDialog(false)}>
            Cancel
          </Button>
          <Button>
            onClick={handleAddPayment}
            disabled={!paymentData.amount || !paymentData.paymentDate}
          >
            Make Payment
          </Button>
        </DialogFooter>
      </Dialog>

      {/* Delete Confirmation Dialog */}
      <Dialog open={showDeleteDialog} onClose={() => setShowDeleteDialog(false)}>
        <DialogHeader>
          <DialogTitle>Delete Card</DialogTitle>
        </DialogHeader>
        <DialogContent className="text-center">
          <img src="/images/delete.png" alt="Delete" className="w-20 h-20 mx-auto mb-4" />
          <p className="text-muted-foreground>Are you sure you want to delete this card? All transactions and payments will also be deleted. This action cannot be undone.</p>"
        </DialogContent>"
        <DialogFooter className="justify-center" sm:justify-center                                                  ">
          <Button variant="outline" onClick={() => setShowDeleteDialog(false)}>
            Cancel
          </Button>
          <Button variant="destructive" onClick={confirmDeleteCard}>
            Delete
          </Button>
        </DialogFooter>
      </Dialog>
    </div>
  );
}
