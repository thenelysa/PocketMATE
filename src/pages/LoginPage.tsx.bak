import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useGoogleLogin } from '@react-oauth/google';
import { useAuth } from '@/contexts/AuthContext';
import { Eye, EyeOff, Mail, Lock, ChevronDown } from 'lucide-react';

const GOOGLE_CLIENT_ID = import.meta.env.VITE_GOOGLE_CLIENT_ID;

export function LoginPage() {
  const { signIn } = useAuth();
  const navigate = useNavigate();
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false);
  const [rememberMe, setRememberMe] = useState(false);
  const [isLoggingIn, setIsLoggingIn] = useState(false);
  const [error, setError] = useState('');
  const [showForm, setShowForm] = useState(false);

  const handleEmailLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!email || !password) {
      setError('Please enter email and password');
      return;
    }
    setIsLoggingIn(true);
    setError('');

    setTimeout(() => {
      signIn({
        id: 'demo-user',
        email: email,
        name: email.split('@')[0],
      });
      navigate('/app/dashboard');
    }, 1000);
  };

  const handleGoogleLogin = useGoogleLogin({
    onSuccess: (response) => {
      setIsLoggingIn(true);
      fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
        headers: { Authorization: `Bearer ${response.access_token}` },
      })
        .then((res) => res.json())
        .then((userInfo) => {
          signIn({
            id: userInfo.sub,
            email: userInfo.email,
            name: userInfo.name,
            picture: userInfo.picture,
          });
          navigate('/app/dashboard');
        })
        .catch(() => {
          setError('Google login failed');
          setIsLoggingIn(false);
        });
    },
    onError: () => {
      setError('Google login failed');
      setIsLoggingIn(false);
    },
  });

  if (!GOOGLE_CLIENT_ID) {
    return (
      <div className="min-h-screen bg-gray-100 flex items-center justify-center p-4">
        <div className="bg-[#F7F8F5] rounded-2xl shadow-lg p-8 max-w-md w-full text-center">
          <h2 className="text-xl font-bold text-[#071936] mb-2}}>Configuration Required</h2>"
          <p className="text-[#4B5D7A] mb-4}>>
            Please add your Google Client ID to the .env file
          </p>"
          <code className="block bg-gray-100 p-3 rounded-lg text-sm text-[#071936]}>>
            VITE_GOOGLE_CLIENT_ID=your_client_id
          </code>
        </div>
      </div>
    );
  }

  return ("
    <div className="min-h-screen bg-gray-100">
      {/* Minimal Header */}
      <header className="h-[72px] border-b border-[#D5ECEB] bg-[#F7F8F5]">
        <div className="max-w-[1110px] mx-auto px-4 h-full flex items-center">
          {/* Logo */}
          <a href="/" className="flex items-center gap-2">
            <img src="/images/logo.png" alt="PocketMATE Logo" className="h-10 w-auto" />
            <span className="text-xl font-bold text-[#071936]}>PocketMATE</span>
          </a>
        </div>
      </header>

      {/* Login Section */}"
      <main className="max-w-[1110px] mx-auto px-4 py-16">
        <div className="flex flex-col items-center justify-center">
          {/* Welcome back card */}
          <div className="w-full max-w-md bg-[#F7F8F5] rounded-2xl shadow-xl p-8">
            <div className="flex items-center justify-between mb-6">
              <h2 className="text-2xl font-bold text-[#071936]}}>Welcome back</h2>
              {showForm && (
                <button
                  onClick={() => setShowForm(false)}"
                  className="text-[#4B5D7A] hover:text-[#071936]"
                >
                  <ChevronDown className="w-5 h-5" />
                </button>
              )}
            </div>

            {error && (
              <div className="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-600 text-sm">
                {error}
              </div>
            )}

            {showForm ? (
              /* Email/Password form */
              <form onSubmit={handleEmailLogin} className="space-y-4">
                <div>
                  <label className="block text-sm font-medium text-[#071936] mb-1.5}>">
                    Email address
                  </label>
                  <div className="relative">
                    <Mail className="absolute left-3 top-1/2 -translate-y-1/2 h-5 w-5 text-[#4B5D7A]" />
                    <input
                      type="email"
                      value={email}
                      onChange={(e) => setEmail(e.target.value)}
                      placeholder="Enter your email"
                      className="w-full pl-11 pr-4 py-3 border border-[#D6E1E8] rounded-xl text-[#071936] placeholder-[#4B5D7A]/50 focus:outline-none focus:ring-2 focus:ring-[#078D88] focus:border-transparent transition-all"
}
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-sm font-medium text-[#071936] mb-1.5}>">
                    Password
                  </label>
                  <div className="relative">
                    <Lock className="absolute left-3 top-1/2 -translate-y-1/2 h-5 w-5 text-[#4B5D7A]" />
                    <input
                      type={showPassword ? 'text' : 'password'}
                      value={password}
                      onChange={(e) => setPassword(e.target.value)}
                      placeholder="Enter your password"
                      className="w-full pl-11 pr-12 py-3 border border-[#D6E1E8] rounded-xl text-[#071936] placeholder-[#4B5D7A]/50 focus:outline-none focus:ring-2 focus:ring-[#078D88] focus:border-transparent transition-all"
                    />
                    <button
                      type="button"
                      onClick={() => setShowPassword(!showPassword)}
                      className="absolute right-3 top-1/2 -translate-y-1/2 text-[#4B5D7A] hover:text-[#071936]"
                    >
                      {showPassword ? <EyeOff className="h-5 w-5" /> : <Eye className="h-5 w-5" />}
                    </button>
                  </div>
                </div>

                <div className="flex items-center justify-between">
                  <label className="flex items-center gap-2 cursor-pointer">
                    <input
                      type="checkbox"
                      checked={rememberMe}
                      onChange={(e) => setRememberMe(e.target.checked)}
                      className="w-4 h-4 rounded border-[#D6E1E8] text-[#078D88] focus:ring-[#078D88]"
                    />
                    <span className="text-sm text-[#4B5D7A]}>Remember me</span>
                  </label>"
                  <a href="#" className="text-sm text-[#078D88] hover:underline">
                    Forgot password?
                  </a>
                </div>

                <button
                  type="submit"
                  disabled={isLoggingIn}
                  className="w-full py-3.5 bg-gradient-to-r from-[#078D88] to-[#19C4B6] text-white rounded-xl hover:opacity-90 transition-opacity disabled:opacity-50"
}
                  {isLoggingIn ? (
                    <span className="flex items-center justify-center gap-2">
                      <div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin" />
                      Logging in...
                    </span>
                  ) : (
                    'Log in'
                  )}
                </button>
              </form>
            ) : null}

            {/* Divider */}
            {showForm && (
              <div className="flex items-center gap-4 my-6">
                <div className="flex-1 h-px bg-[#D6E1E8]" />
                <span className="text-sm text-[#4B5D7A]>or</span>"
                <div className="flex-1 h-px bg-[#D6E1E8]" />
              </div>
            )}

            {/* Google Login */}
            <button
              onClick={() => showForm ? setShowForm(false) : handleGoogleLogin()}
              disabled={isLoggingIn}
              className="w-full py-3 bg-[#F7F8F5] border-2 border-[#D6E1E8] text-[#071936] rounded-xl hover:bg-gray-100 transition-colors disabled:opacity-50 flex items-center justify-center gap-3"
            >
              <svg className="w-5 h-5" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
              </svg>
              Continue with Google
            </button>

            {/* Sign Up info */}
            <p className="text-center text-sm text-[#4B5D7A] mt-6">
              Don't have an account?{' '}
              <a href="#" className="text-[#078D88] font-medium hover:underline">
                Create account
              </a>
            </p>
          </div>
        </div>
      </main>
    </div>
  );
}
