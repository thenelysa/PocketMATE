# Copy this file to .env.local and fill in real values.
# Next.js loads .env.local automatically. NEVER commit .env.local.

# --- Database (server-side only) ---
# Postgres connection string. Required by every /api route AND by the Prisma CLI
# (prisma.config.ts reads this file directly when you run npm run db:migrate).
# Neon dashboard -> Connection Details -> "Connection string" (pooled).
# Local Postgres also works: postgresql://postgres:pw@localhost:5432/pocketmate
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Google OAuth (exposed to the browser) ---
# Must be NEXT_PUBLIC_* — it is read in a Client Component (app/layout.tsx).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web).
# Authorised JavaScript origin must include http://localhost:3000 for local dev.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
